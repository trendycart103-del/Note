name: Build APK

on:
  workflow_dispatch:
  push:

jobs:
  build:
    runs-on: ubuntu-24.04
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Accept Android licenses and install platform
        run: |
          SDKM="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
          yes | "$SDKM" --licenses > /dev/null || true
          "$SDKM" "platforms;android-34" "build-tools;34.0.0"

      - name: Setup Gradle 8.7
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.7"

      - name: Find project
        run: |
          ls -la
          ZIP=$(find . -maxdepth 2 -iname "*.zip" | head -n1)
          if [ -n "$ZIP" ]; then
            echo "Unzipping $ZIP"
            mkdir -p work
            unzip -o "$ZIP" -d work
          fi
          SET=$(find . -name settings.gradle.kts | head -n1)
          echo "Found: $SET"
          test -n "$SET"
          echo "PROJECT_DIR=$(dirname "$SET")" >> $GITHUB_ENV

      - name: Build debug APK
        run: |
          cd "$PROJECT_DIR"
          gradle assembleDebug --no-daemon

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: hajira-notebook-apk
          path: "**/outputs/apk/debug/*.apk"
